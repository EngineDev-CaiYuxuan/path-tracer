#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba8, binding = 0) uniform writeonly image2D outputImage;

layout(binding = 1) uniform CameraBuffer{
    vec4 camPos;
    vec4 camForward;
    vec4 camRight;
    vec4 camUp;
    vec4 params;
} cam;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;


    vec3 pos = cam.camPos.xyz;
    float fovTanHalf = cam.params.x;
    float aspect = cam.params.y;
    uint frameIndex = uint(cam.params.z);

    vec3 dir = normalize(
        cam.camForward.xyz
        + uv.x * aspect * fovTanHalf * cam.camRight.xyz
        + uv.y * fovTanHalf * cam.camUp.xyz
    );


    vec3 color = dir * 0.5 + 0.5;
    imageStore(outputImage, pixel, vec4(color, 1.0));
}