#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba32f, binding = 0) uniform image2D outputImage;

layout(binding = 1) uniform CameraBuffer
{
    vec4 camPos;
    vec4 camForward;
    vec4 camRight;
    vec4 camUp;
    vec4 params;
} cam;

layout(binding = 2) uniform SceneInfo
{
    uint triangleCount;
} sceneInfo;

struct Triangle
{
    vec4 v[3];
};

layout(binding = 3) readonly buffer TriangleBuffer
{
    Triangle triangles[];
};

struct Ray
{
    vec3 origin;
    vec3 dir;
};

struct HitInfo
{
    bool isHit;
    float t;
    vec3 position;
    vec3 normal;
};

// auxiliary functions

uint pcg_hash(uint seed)
{
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand(inout uint seed)
{
    seed = pcg_hash(seed);
    return float(seed) / 4294967296.0;
}


// 

HitInfo intersectTriangle(Ray ray, vec3 v0, vec3 v1, vec3 v2)
{
    HitInfo hitInfo;
    hitInfo.isHit = false;
    hitInfo.t = 1e30;
    hitInfo.position = vec3(0.0);
    hitInfo.normal = vec3(0.0);

    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(ray.dir, edge2);
    float a = dot(edge1, h);
    if (abs(a) < 1e-8) return hitInfo;

    float f = 1.0 / a;
    vec3 s = ray.origin - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return hitInfo;

    vec3 q = cross(s, edge1);
    float v = f * dot(ray.dir, q);
    if (v < 0.0 || u + v > 1.0) return hitInfo;

    float t = f * dot(edge2, q);
    if (t > 1e-8) { 
        hitInfo.isHit = true;
        hitInfo.t = t;
        hitInfo.position = ray.origin + ray.dir * t;
        vec3 N = normalize(cross(edge1, edge2));
        if (dot(ray.dir, N) > 0.0) N = -N;
        hitInfo.normal = N;
    }
    return hitInfo;
}

HitInfo traceScene(Ray ray) 
{
    HitInfo closest;
    closest.isHit = false;
    closest.t   = 1e30;

    HitInfo h;
    for (uint i = 0; i < sceneInfo.triangleCount; i++)
    {
        h = intersectTriangle(ray, triangles[i].v[0].xyz, triangles[i].v[1].xyz, triangles[i].v[2].xyz);
        if(h.isHit && h.t < closest.t)
        {
            closest = h;
        }
    }

    return closest;
}

vec3 sampleCosineHemisphere(vec3 N, inout uint seed)
{
    float r1 = rand(seed);
    float r2 = rand(seed);

    float phi = 2 * 3.1415926 * r2;
    float cosTheta = sqrt(1 - r1);
    float sinTheta = sqrt(r1);

    vec3 w = N;
    vec3 u = normalize(cross(abs(w.x) > 0.999 ? vec3(0,1,0) : vec3(1,0,0), w));
    vec3 v = cross(w, u);

    return normalize(u * cos(phi) * sinTheta + v * sin(phi) * sinTheta + w * cosTheta);
}


void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    uv.y = -uv.y;

    vec3 pos = cam.camPos.xyz;
    float fovTanHalf = cam.params.x;
    float aspect = cam.params.y;
    uint frameIndex = uint(cam.params.z);

    vec3 forwardMove = cam.camForward.xyz * 1.0;
    vec3 upMove = cam.camUp.xyz * fovTanHalf * uv.y;
    vec3 rightMove = cam.camRight.xyz * fovTanHalf * aspect * uv.x;
    vec3 dir = normalize(forwardMove + upMove + rightMove);


    uint seed = uint(pixel.x) + uint(pixel.y) * uint(size.x) + frameIndex * 1920u * 1080u;
    
    Ray ray = {cam.camPos.xyz, dir};
    const int MAX_DEPTH = 5;
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    

    for (int i = 0; i < MAX_DEPTH; i++)
    {
        HitInfo hit = traceScene(ray);
        if (!hit.isHit)
        {
            radiance += throughput * vec3(0.5, 0.7, 1.0); 
            break;
        }

        vec3 albedo = vec3(0.8);
        vec3 pointLight = vec3(-30.0, 80.0, 60.0); 
        vec3 lightDir = normalize(pointLight - hit.position);

        Ray shadowRay = { hit.position + hit.normal * 1e-4, lightDir };
        HitInfo shadowHit = traceScene(shadowRay);
        if (!shadowHit.isHit)
        {
            float NdotL = max(0.0, dot(lightDir, hit.normal));
            radiance += throughput * albedo * vec3(1.0, 1.0, 0.8) * NdotL; 
        }

        
        throughput *= albedo;

        if (i > 2)
        {
            float p = max(throughput.r, max(throughput.g, throughput.b));
            if (p < 0.001) break;
            if (rand(seed) > p) break;
            throughput /= p;
        }

        ray.origin = hit.position + hit.normal * 1e-4;
        ray.dir = sampleCosineHemisphere(hit.normal, seed);
    }

    radiance = min(radiance, vec3(1.0));


    vec4 prevData = imageLoad(outputImage, pixel);
    uint frameCount = uint(cam.params.z);

    vec3 color;
    if (frameCount == 0)
    {
        color = radiance;
    }
    else
    {
        vec3 prevColor = prevData.rgb;
        color = (prevColor * float(frameCount) + radiance) / (frameCount + 1);
    }


    imageStore(outputImage, pixel, vec4(color, 1.0));
}