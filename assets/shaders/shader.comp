#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba8, binding = 0) uniform writeonly image2D outputImage;

layout(binding = 1) uniform CameraBuffer{
    vec4 camPos;
    vec4 camForward;
    vec4 camRight;
    vec4 camUp;
    vec4 params;
} cam;

layout(binding = 2) uniform SceneInfo{
    uint triangleCount;
} sceneInfo;

struct Triangle{
    vec4 v[3];
};

layout(binding = 3) readonly buffer TriangleBuffer{
    Triangle triangles[];
};

struct Ray{
    vec3 origin;
    vec3 dir;
};

struct HitInfo{
    bool isHit;
    float t;
    vec3 position;
    vec3 normal;
};

HitInfo intersectTriangle(Ray ray, vec3 v0, vec3 v1, vec3 v2){
    HitInfo hitInfo;
    hitInfo.isHit = false;
    hitInfo.t = 1e30;
    hitInfo.position = vec3(0.0);
    hitInfo.normal = vec3(0.0);

    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(ray.dir, edge2);
    float a = dot(edge1, h);
    if (abs(a) < 1e-8) return hitInfo;

    float f = 1.0 / a;
    vec3 s = ray.origin - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return hitInfo;

    vec3 q = cross(s, edge1);
    float v = f * dot(ray.dir, q);
    if (v < 0.0 || u + v > 1.0) return hitInfo;

    float t = f * dot(edge2, q);
    if (t > 1e-8) { 
        hitInfo.isHit = true;
        hitInfo.t = t;
        hitInfo.position = ray.origin + ray.dir * t;
        vec3 N = normalize(cross(edge1, edge2));
        if (dot(ray.dir, N) > 0.0) N = -N;
        hitInfo.normal = N;
    }
    return hitInfo;
}

HitInfo traceScene(Ray ray) {
    HitInfo closest;
    closest.isHit = false;
    closest.t   = 1e30;

    HitInfo h;
    for (uint i = 0; i < sceneInfo.triangleCount; i++)
    {
        h = intersectTriangle(ray, triangles[i].v[0].xyz, triangles[i].v[1].xyz, triangles[i].v[2].xyz);
        if(h.isHit && h.t < closest.t)
        {
            closest = h;
        }
    }

    return closest;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    uv.y = -uv.y;

    vec3 pos = cam.camPos.xyz;
    float fovTanHalf = cam.params.x;
    float aspect = cam.params.y;
    uint frameIndex = uint(cam.params.z);

    vec3 forwardMove = cam.camForward.xyz * 1.0;
    vec3 upMove = cam.camUp.xyz * fovTanHalf * uv.y;
    vec3 rightMove = cam.camRight.xyz * fovTanHalf * aspect * uv.x;
    vec3 dir = normalize(forwardMove + upMove + rightMove);


    Ray ray = {cam.camPos.xyz, dir};
    HitInfo hitInfo = traceScene(ray);
    vec3 color = vec3(0.0);
    if (hitInfo.isHit)
    {
        vec3 lightDir = normalize(vec3(-1.0, 1.0, -1.0)); 
        vec3 lightColor = vec3(1.0, 1.0, 0.8);           
        vec3 albedo = vec3(0.8, 0.8, 0.8);                

        Ray shadowRay = {hitInfo.position + hitInfo.normal * 1e-4, lightDir};
        HitInfo lightHit = traceScene(shadowRay);

        if (lightHit.isHit == false)
        {
            float NdotL = dot(hitInfo.normal, lightDir);
            color = albedo * lightColor * NdotL;
        }
        else
        {
            color = vec3(0.05); 
        }
    }


    imageStore(outputImage, pixel, vec4(color, 1.0));
}